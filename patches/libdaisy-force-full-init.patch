-    if(boot_version == System::BootInfo::Version::LT_v6_0
+    auto memory                    = System::GetProgramMemoryRegion();
+    [[maybe_unused]] auto boot_version = System::GetBootloaderVersion();
+
+    // DAISY_FORCE_FULL_INIT: defined for the Alchemy SWD/SRAM debug image.
+    // That image is loaded straight into SRAM by the probe (no bootloader), so
+    // NOTHING has set up the chip. These two heuristics normally let a launching
+    // bootloader own clock + SDRAM bring-up, but they key off boot_version, which
+    // for a SWD image is read from battery-backed backup SRAM and is stale/garbage
+    // (and unstable run-to-run). When it skips ConfigureClocks(), PLL3 is off and
+    // the ADC calibration in hw.Init() spins forever. When it skips sdram_handle
+    // .Init(), the first write to the SDRAM buffers (0xc0000000) is an imprecise
+    // bus fault -> HardFault. Forcing the full bring-up makes SRAM debug reliable.
+    // The deploy (bootloader-launched) build never defines this.
+#ifndef DAISY_FORCE_FULL_INIT
+    if(boot_version == System::BootInfo::Version::NONE
        && memory != System::MemoryRegion::INTERNAL_FLASH)
     {
         syscfg.skip_clocks = true;
     }
+#endif
 
     system.Init(syscfg);
 
     if(memory != System::MemoryRegion::QSPI)
         qspi.Init(qspi_config);
 
+#ifdef DAISY_FORCE_FULL_INIT
+    if(true) // SWD/SRAM debug image: no bootloader inited SDRAM, so always do it
+#else
     if(boot_version != System::BootInfo::Version::LT_v6_0
        || (boot_version == System::BootInfo::Version::LT_v6_0
            && memory == System::MemoryRegion::INTERNAL_FLASH))
+#endif
